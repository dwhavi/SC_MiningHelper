{
  "name": "SC_PadControl 덱",
  "version": 2,
  "tap_ms": 60,
  "notes": "SC 4.x 기본 키 기준 (nodieCode/tablet-deck 레이아웃 참고). 인게임에서 키를 바꿨으면 여기서도 같은 키로 고치세요. mode: tap=짧게 누름, hold=누르는 동안, timed=ms만큼 유지.",
  "pages": [
    {
      "id": "mining",
      "name": "채굴",
      "buttons": [
        {"label": "채굴 모드", "keys": "ralt+m", "mode": "tap"},
        {"label": "레이저 발사", "keys": "rctrl+f", "mode": "tap"},
        {"label": "파쇄/추출", "keys": "rctrl+t", "mode": "tap"},
        {"label": "출력 +", "keys": "rctrl+w", "mode": "hold"},
        {"label": "출력 −", "keys": "rctrl+s", "mode": "hold"},
        {"label": "모듈 1", "keys": "lalt+1", "mode": "tap"},
        {"label": "모듈 2", "keys": "lalt+2", "mode": "tap"},
        {"label": "모듈 3", "keys": "lalt+3", "mode": "tap"},
        {"label": "스캔 핑", "keys": "v", "mode": "tap"},
        {"label": "스캔 모드", "keys": "ralt+v", "mode": "tap"}
      ]
    },
    {
      "id": "ship",
      "name": "선박",
      "buttons": [
        {"label": "비행 준비", "keys": "r", "mode": "tap"},
        {"label": "전원", "keys": "u", "mode": "tap"},
        {"label": "랜딩기어", "keys": "n", "mode": "tap"},
        {"label": "착륙 요청", "keys": "lalt+n", "mode": "tap"},
        {"label": "VTOL", "keys": "k", "mode": "tap"},
        {"label": "전등", "keys": "l", "mode": "tap"},
        {"label": "퀀텀 점프", "keys": "b", "mode": "hold"},
        {"label": "좌석 내리기", "keys": "y", "mode": "timed", "ms": 1200},
        {"label": "무기 출력", "keys": "f5", "mode": "tap"},
        {"label": "엔진 출력", "keys": "f6", "mode": "tap"},
        {"label": "실드 출력", "keys": "f7", "mode": "tap"},
        {"label": "출력 초기화", "keys": "f8", "mode": "tap"}
      ]
    },
    {
      "id": "general",
      "name": "일반",
      "buttons": [
        {"label": "상호작용", "keys": "f", "mode": "tap"},
        {"label": "모비글라스", "keys": "f1", "mode": "tap"},
        {"label": "스타맵", "keys": "f2", "mode": "tap"},
        {"label": "인벤토리", "keys": "i", "mode": "tap"},
        {"label": "연락처", "keys": "f11", "mode": "tap"},
        {"label": "3인칭", "keys": "f4", "mode": "tap"},
        {"label": "문 열기", "keys": "lalt+o", "mode": "tap"},
        {"label": "문 토글", "keys": "np_period", "mode": "tap"},
        {"label": "채팅", "keys": "enter", "mode": "tap"},
        {"label": "ESC", "keys": "esc", "mode": "tap"}
      ]
    }
  ]
}
